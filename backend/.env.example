# Copy to backend/.env and adjust. Values here are placeholders.
POSTGRES_DB=adosx
POSTGRES_USER=adosx
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Leave blank in dev (random per process). Set a long random value when DJANGO_DEBUG=0.
DJANGO_SECRET_KEY=
# Demo tenant switching (stand-in for login). Defaults to DJANGO_DEBUG.
ADOSX_DEMO_TENANT_SWITCHING=1
DJANGO_DEBUG=1
